{
  "name": "@learning-site/themes",
  "version": "1.0.0",
  "private": true,
  "description": "Official portable theme packages for Learning Site Engine",
  "type": "module",
  "exports": {
    "./registry": "./dist/src/generate-registry.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/src/generate-registry.js",
    "generate:registry": "tsx src/generate-registry.ts",
    "validate": "tsx src/validate-themes.ts",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "release:check": "npm run lint && npm test && npm run validate",
    "package:release": "npm run build && tsx src/package-themes.ts"
  },
  "dependencies": {
    "@learning-site/engine": "file:../learning-site-engine"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
